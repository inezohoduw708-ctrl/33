{
  "name": "tmnt-shadows-of-new-york",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test:smoke": "esbuild tests/run.ts --bundle --platform=node --format=cjs --outfile=tests/run.cjs --loader:.ts=ts --external:jsdom --log-level=warning && node tests/run.cjs",
    "test:boot": "esbuild tests/boot.ts --bundle --platform=node --format=cjs --outfile=tests/boot.cjs --loader:.ts=ts --external:jsdom --log-level=warning && node tests/boot.cjs",
    "test:play": "esbuild tests/playthrough.ts --bundle --platform=node --format=cjs --outfile=tests/play.cjs --loader:.ts=ts --external:jsdom --log-level=warning && node tests/play.cjs",
    "shots": "esbuild tests/scene_shot.ts --bundle --platform=node --format=cjs --outfile=tests/shot.cjs --loader:.ts=ts --external:jsdom --log-level=warning && node tests/shot.cjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "description": "3D TMNT action game for the browser: New York streets, 4 turtles, combos, Shredder boss, progress saving."
}
